# Vercel Postgres (Neon) が自動で注入する接続文字列を使う。
# DATABASE_URL はアプリ実行用（プーラー経由可）、
# DATABASE_URL_UNPOOLED はマイグレーション用の直接接続。
# ローカル開発時は同じ接続文字列を両方に設定すればよい。
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host/dbname?sslmode=require"

# ログインパスワード。未設定だとアプリはセットアップ案内だけを表示する。
# サイトのID/パスワードを保存するため、本番では必ず設定すること。
# セッションの署名鍵はこの値から導出されるため、変更すると再ログインが必要になる。
APP_PASSWORD="お好きなパスワード"
